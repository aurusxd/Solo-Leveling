# Copy to .env for local development. Leave secrets empty: the app starts without them.

NODE_ENV=development
DATABASE_URL=postgres://life_rpg:life_rpg@localhost:5432/life_rpg

# Telegram bot token, required in production.
BOT_TOKEN=

# Empty selects FakeLlmClient.
DEEPSEEK_API_KEY=

# Dev only. The app refuses to start with either flag in production.
DEV_AUTH_BYPASS=true
ENTITLEMENTS_ALL=true
